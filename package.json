{
  "name": "lagiote-revise",
  "version": "1.30.1",
  "description": "Lagiote Revise - offline flashcard app",
  "main": "electron-main.cjs",
  "productName": "Lagiote Revise",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TJ7755/Lagiote-revise.git"
  },
  "author": "TJ7755",
  "license": "GPL-3.0",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "start:electron": "node scripts/start-electron.cjs",
    "make": "npm run build:web && electron-forge make",
    "dev:web": "vite",
    "build:web": "vite build",
    "build": "npm run build:web",
    "preview:web": "vite preview",
    "dev:electron": "node scripts/start-electron.cjs",
    "smoke:web": "npm run build:web && node tests/smoke.build.mjs",
    "check:structure": "node scripts/check-runtime-structure.mjs",
    "test": "node scripts/test-node.mjs",
    "test:unit": "npm run test && vitest run",
    "test:e2e:web": "playwright test -c playwright.web.config.mjs",
    "test:e2e:electron": "playwright test -c playwright.electron.config.mjs",
    "test:all": "node scripts/test-all.mjs",
    "package": "npm run build:web && electron-forge package",
    "test:install": "playwright install chromium"
  },
  "config": {},
  "keywords": [],
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/publisher-github": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@playwright/test": "^1.64.1",
    "electron": "^45.0.0",
    "fake-indexeddb": "^6.2.6",
    "playwright": "^1.64.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.29.0",
    "@google/genai": "^2.31.0",
    "axios": "^1.20.0",
    "chart.js": "^4.6.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "jwt-decode": "^4.0.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "sortablejs": "^1.15.7",
    "ts-fsrs": "^5.4.2",
    "update-electron-app": "^3.3.0"
  },
  "bugs": {
    "url": "https://github.com/TJ7755/Lagiote-revise/issues"
  },
  "homepage": "https://github.com/TJ7755/Lagiote-revise#readme",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1",
    "npm": ">=12.2.1"
  },
  "packageManager": "npm@12.2.1"
}

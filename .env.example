# Copy this file to .env.local and fill in values for your environment.
PROXY_URL=https://your-proxy.hf.space
ELECTRON_AUTH0_DOMAIN=your-tenant.auth0.com
ELECTRON_AUTH0_CLIENT_ID=your-client-id
ELECTRON_AUTH0_AUDIENCE=https://your-api/
ELECTRON_AUTH0_REDIRECT_URI=http://localhost:3000/callback
GEMINI_API_KEY=your-gemini-api-key
DATABASE_URL=postgres://user:pass@host:5432/db
